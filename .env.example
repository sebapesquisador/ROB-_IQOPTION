# ============================================================
# CONFIGURAÇÃO DO ROBÔ — copie para .env e preencha
#   cp .env.example .env
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# ============================================================

# ---- Corretora: paper | iqoption | binance ----
BROKER=paper
# demo | real
ACCOUNT_MODE=demo
# true = simula ordens sem enviar a corretora (comece SEMPRE assim)
DRY_RUN=true

# ---- Credenciais IQ Option ----
IQ_EMAIL=
IQ_PASSWORD=

# ---- Credenciais Binance ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ---- Mercado ----
SYMBOL=EURUSD
TIMEFRAME_MINUTES=5
EXPIRATION_MINUTES=5
AUTO_OTC=true
CANDLES_LOOKBACK=300
POLL_INTERVAL_SECONDS=5

# ---- Estratégia ----
# Opcoes: rsi_reversal | trend_pullback | bollinger_reversion | macd_momentum |
#         confluence | wpr_extremes
STRAT_NAME=confluence
STRAT_MIN_CONFIDENCE=0.60
STRAT_RSI_PERIOD=14
STRAT_RSI_OVERSOLD=30
STRAT_RSI_OVERBOUGHT=70
STRAT_MA_FAST_PERIOD=9
STRAT_MA_SLOW_PERIOD=21
STRAT_BB_PERIOD=20
STRAT_BB_STD=2.0
STRAT_REQUIRE_TREND_ALIGNMENT=true
STRAT_MIN_ATR_PCT=0.02
STRAT_MAX_ATR_PCT=2.0

# ---- Williams %R (estrategia wpr_extremes) ----
# O oscilador vai de -100 (fechou na minima da janela) a 0 (fechou na maxima).
# Os quatro niveis abaixo sao os que voce mexe para calibrar a estrategia.
#
#   -100 |======= COMPRA =======|                              |== VENDA ==| 0
#         (abaixo de BUY)        (sai da compra acima de EXIT_BUY)
#
# Janela do indicador, em candles
STRAT_WPR_PERIOD=20
# Entra COMPRADO quando o WPR fica abaixo deste nivel
STRAT_WPR_BUY=-95
# Entra VENDIDO quando o WPR fica acima deste nivel
STRAT_WPR_SELL=-5
# Encerra a COMPRA quando o WPR sobe acima deste nivel
STRAT_WPR_EXIT_BUY=-20
# Encerra a VENDA quando o WPR cai abaixo deste nivel
STRAT_WPR_EXIT_SELL=-80
#
# Regras que a configuracao cobra (senao o robo recusa iniciar):
#   EXIT_BUY  > BUY        EXIT_SELL < SELL        BUY < SELL
# Niveis mais frouxos (-80 / -20) geram muito mais operacoes;
# mais apertados (-98 / -2) geram poucas e mais raras.

# ---- Gestão de risco (NÃO afrouxe sem entender) ----
# fixed | percent
RISK_SIZING_MODE=percent
# % do saldo por operacao
RISK_PERCENT_STAKE=1.0
RISK_FIXED_STAKE=5.0
# para tudo ao perder 5% no dia
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_MAX_TOTAL_DRAWDOWN_PCT=20.0
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_COOLDOWN_AFTER_LOSS_STREAK_MIN=30
RISK_DAILY_PROFIT_TARGET_PCT=5.0
RISK_MAX_TRADES_PER_DAY=30
RISK_MAX_CONCURRENT_POSITIONS=1
RISK_MIN_SECONDS_BETWEEN_TRADES=60
# mantenha FALSE — martingale e a forma mais rapida de zerar a conta
RISK_MARTINGALE_ENABLED=false

# ---- Sessão de negociação ----
SESSION_TIMEZONE=America/Sao_Paulo
SESSION_START_TIME=09:00
SESSION_END_TIME=17:00
SESSION_TRADE_ON_WEEKENDS=false

# ---- Painel ----
API_HOST=0.0.0.0
# Se esta porta estiver ocupada, o painel migra sozinho para a próxima livre
API_PORT=8000
# Defina um token se expuser o painel na rede. Vazio = sem autenticacao (apenas local).
API_TOKEN=

# ---- Logs ----
LOG_LEVEL=INFO
LOG_JSON=false
